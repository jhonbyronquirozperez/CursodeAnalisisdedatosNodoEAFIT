---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/inicio/Hero.astro';
import Ticker from '../components/inicio/Ticker.astro';
import Instructor from '../components/inicio/Instructor.astro';
import Progreso from '../components/Progreso.astro';
import { curso } from '../config/curso';
import { obtenerCurso, urlModulo, dosDigitos } from '../lib/curso';
import { estiloModulo } from '../lib/colores';

const modulos = await obtenerCurso();
const consulta = 'SELECT orden, modulo, lecciones, listas\nFROM curso.modulos\nORDER BY orden;';

const info = [
  { etiqueta: 'Instructor', valor: curso.instructor.nombre },
  { etiqueta: 'Modalidad', valor: curso.modalidad },
  { etiqueta: 'Horario', valor: curso.horario },
];
---

<BaseLayout completo>
  <Hero />
  <Ticker />

  <section id="modulos" class="seccion contenedor" aria-labelledby="titulo-modulos">
    <div class="encabezado-seccion">
      <p class="sobretitulo">Ruta del curso</p>
      <h2 id="titulo-modulos">Módulos</h2>
      <p class="intro">Seis módulos, en orden. Entra a cualquiera para ver sus lecciones.</p>
    </div>

    <div class="terminal">
      <div class="terminal-barra">
        <span class="luces" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="terminal-titulo">psql — analisis_datos</span>
      </div>
      <div class="terminal-cuerpo">
        <p class="prompt" aria-hidden="true">analisis_datos=#</p>
        <Code code={consulta} lang="sql" theme="github-dark-default" />
        <div class="resultado">
          <table>
            <caption class="sr-only">Módulos del curso con lecciones totales y lecciones listas</caption>
            <thead>
              <tr>
                <th scope="col">orden</th>
                <th scope="col">modulo</th>
                <th scope="col" class="num">lecciones</th>
                <th scope="col">listas</th>
              </tr>
            </thead>
            <tbody>
              {
                modulos.map((m) => (
                  <tr data-color style={estiloModulo(m.id)}>
                    <td class="orden">{dosDigitos(m.data.orden)}</td>
                    <td>
                      <a href={urlModulo(m)}>
                        <span class="punto" aria-hidden="true" />
                        {m.data.titulo}
                      </a>
                    </td>
                    <td class="num">{m.lecciones.length}</td>
                    <td>
                      <div class="listas">
                        <span class="num">{m.listas}</span>
                        <Progreso listas={m.listas} total={m.lecciones.length} />
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="filas">({modulos.length} {modulos.length === 1 ? 'fila' : 'filas'})</p>
          <p class="prompt" aria-hidden="true">analisis_datos=# <span class="cursor"></span></p>
        </div>
      </div>
    </div>
  </section>

  <div class="separador contenedor" aria-hidden="true"></div>

  <Instructor />

  <section id="info" class="seccion contenedor" aria-labelledby="titulo-info">
    <div class="encabezado-seccion">
      <p class="sobretitulo">Datos generales</p>
      <h2 id="titulo-info">Información del curso</h2>
    </div>
    <dl class="info">
      {
        info.map((i) => (
          <div>
            <dt>{i.etiqueta}</dt>
            <dd class:list={{ 'por-definir': !i.valor }}>{i.valor || 'Por definir'}</dd>
          </div>
        ))
      }
      <div>
        <dt>Requisitos</dt>
        {
          curso.requisitos.length > 0 ? (
            <dd>
              <ul>
                {curso.requisitos.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </dd>
          ) : (
            <dd class="por-definir">Por definir</dd>
          )
        }
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .seccion {
    padding: 5rem 0 2rem;
  }
  .encabezado-seccion {
    margin-bottom: 2rem;
  }
  .encabezado-seccion h2 {
    margin: 0.4rem 0 0.5rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
  }
  .intro {
    margin: 0;
    color: var(--texto-suave);
  }
  .separador {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--borde-fuerte), transparent);
  }

  /* ----- Terminal ----- */
  .terminal {
    border: 1px solid var(--borde-fuerte);
    background: var(--codigo-fondo);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.5),
      0 24px 60px -24px rgb(38 250 242 / 0.25);
  }
  .terminal-barra {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--borde);
    background: var(--fondo-suave);
  }
  .luces {
    display: flex;
    gap: 0.4rem;
  }
  .luces span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--naranja);
  }
  .luces span:nth-child(2) {
    background: var(--lima);
  }
  .luces span:nth-child(3) {
    background: var(--cian);
  }
  .terminal-titulo {
    font-family: var(--fuente-codigo);
    font-size: 0.75rem;
    color: var(--texto-suave);
  }
  .terminal-cuerpo {
    padding: 1.1rem 1.25rem 1rem;
  }
  .prompt {
    margin: 0;
    font-family: var(--fuente-codigo);
    font-size: 0.82rem;
    color: var(--lima);
  }
  .terminal-cuerpo :global(pre.astro-code) {
    margin: 0.25rem 0 1.25rem;
    padding: 0;
    border: 0;
    background: transparent !important;
    font-size: 0.95rem;
  }
  .terminal-cuerpo :global(pre.astro-code)::before {
    content: none;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--lima);
    animation: parpadeo 1s steps(1) infinite;
  }
  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .resultado {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  th {
    font-family: var(--fuente-codigo);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    color: var(--texto-suave);
    padding: 0.4rem 0.75rem;
    border-bottom: 1px dashed var(--borde-fuerte);
    white-space: nowrap;
  }
  td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--borde);
    vertical-align: middle;
  }
  tbody tr {
    transition: background-color 0.2s;
  }
  tbody tr:hover {
    background: var(--mod-fondo);
  }
  tbody tr:hover .orden {
    box-shadow: inset 3px 0 0 var(--mod);
  }
  .num {
    font-family: var(--fuente-codigo);
    text-align: right;
    font-size: 0.9rem;
  }
  th.num {
    text-align: right;
    font-size: 0.75rem;
  }
  .orden {
    font-family: var(--fuente-codigo);
    font-weight: 600;
    color: var(--mod);
    width: 4.5rem;
  }
  td a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--fuente-titulos);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--texto);
    text-decoration: none;
  }
  td a:hover {
    color: var(--mod);
  }
  .punto {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--mod);
    box-shadow: 0 0 10px var(--mod);
    flex: none;
  }
  .listas {
    display: grid;
    grid-template-columns: 1.5rem minmax(4rem, 9rem);
    align-items: center;
    gap: 0.6rem;
  }
  .filas {
    font-family: var(--fuente-codigo);
    font-size: 0.75rem;
    color: var(--texto-suave);
    margin: 0.75rem 0 0.5rem;
  }

  /* ----- Información del curso ----- */
  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin: 0 0 3rem;
  }
  .info > div {
    position: relative;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--borde);
    border-top: 2px solid var(--cian);
    background: var(--fondo-elevado);
  }
  .info > div:nth-child(2) {
    border-top-color: var(--lima);
  }
  .info > div:nth-child(3) {
    border-top-color: var(--naranja);
  }
  .info > div:nth-child(4) {
    border-top-color: var(--rosa);
  }
  dt {
    font-family: var(--fuente-codigo);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--texto-suave);
    margin-bottom: 0.35rem;
  }
  dd {
    margin: 0;
    font-weight: 600;
    font-size: 1.1rem;
  }
  dd ul {
    margin: 0;
    padding-left: 1.1rem;
    font-weight: 400;
    font-size: 1rem;
  }

  @media (max-width: 560px) {
    .seccion {
      padding-top: 3.5rem;
    }
    .terminal-cuerpo {
      padding: 1rem 0.75rem;
    }
    .terminal-cuerpo :global(pre.astro-code) {
      font-size: 0.8rem;
    }
    .orden {
      width: auto;
    }
    .listas {
      grid-template-columns: 1rem 2.5rem;
      gap: 0.4rem;
    }
    th,
    td {
      padding-left: 0.3rem;
      padding-right: 0.3rem;
    }
    th {
      font-size: 0.68rem;
    }
    td a {
      gap: 0.45rem;
      font-size: 0.95rem;
    }
  }
</style>
