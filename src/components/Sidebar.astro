---
import { obtenerCurso, urlModulo, urlLeccion, numeroLeccion, dosDigitos, url } from '../lib/curso';
import { estiloModulo } from '../lib/colores';

interface Props {
  moduloActual?: string;
  leccionActual?: string;
}
const { moduloActual, leccionActual } = Astro.props;
const modulos = await obtenerCurso();
---

<nav class="lateral" aria-label="Módulos del curso">
  <p class="lateral-titulo" id="lateral-titulo">Módulos</p>
  <ol class="lista-modulos" aria-labelledby="lateral-titulo">
    {
      modulos.map((m) => {
        const actual = m.id === moduloActual;
        return (
          <li data-color style={estiloModulo(m.id)} class:list={{ actual }}>
            <a
              class="enlace-modulo"
              href={urlModulo(m)}
              aria-current={actual && !leccionActual ? 'page' : undefined}
            >
              <span class="num">{dosDigitos(m.data.orden)}</span>
              <span class="nombre">{m.data.titulo}</span>
              <span class="cuenta" aria-label={`${m.listas} de ${m.lecciones.length} lecciones listas`}>
                {m.listas}/{m.lecciones.length}
              </span>
            </a>
            {actual && m.lecciones.length > 0 && (
              <ol class="lista-lecciones">
                {m.lecciones.map((l) => (
                  <li>
                    <a
                      href={urlLeccion(m, l)}
                      aria-current={l.id === leccionActual ? 'page' : undefined}
                    >
                      <span class="num-l">{numeroLeccion(m, l)}</span>
                      <span>{l.data.titulo}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        );
      })
    }
  </ol>
  <a class="volver-inicio" href={url()}>← Inicio del curso</a>
</nav>

<style>
  .lateral {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .lateral-titulo {
    margin: 0;
    font-family: var(--fuente-codigo);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--texto-suave);
  }
  .lista-modulos,
  .lista-lecciones {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lista-modulos {
    display: grid;
    gap: 0.25rem;
  }
  .enlace-modulo {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radio);
    color: var(--texto);
    text-decoration: none;
    border-left: 3px solid transparent;
  }
  .enlace-modulo:hover {
    background: var(--fondo-suave);
  }
  .actual > .enlace-modulo {
    background: var(--mod-fondo);
    border-left-color: var(--mod);
    box-shadow: -6px 0 16px -8px var(--mod);
  }
  .enlace-modulo:hover .nombre {
    color: var(--mod);
  }
  .num {
    font-family: var(--fuente-codigo);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--mod);
  }
  .nombre {
    font-weight: 600;
    line-height: 1.25;
  }
  .cuenta {
    font-family: var(--fuente-codigo);
    font-size: 0.7rem;
    color: var(--texto-suave);
  }
  .lista-lecciones {
    margin: 0.25rem 0 0.5rem 1.1rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--borde);
    display: grid;
    gap: 0.1rem;
  }
  .lista-lecciones a {
    display: flex;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    font-size: 0.92rem;
    color: var(--texto-suave);
    text-decoration: none;
    line-height: 1.3;
  }
  .lista-lecciones a:hover {
    color: var(--texto);
    background: var(--fondo-suave);
  }
  .lista-lecciones a[aria-current='page'] {
    color: var(--texto);
    font-weight: 600;
    background: var(--mod-fondo);
  }
  .num-l {
    font-family: var(--fuente-codigo);
    font-size: 0.72rem;
    color: var(--mod);
    padding-top: 0.15rem;
    min-width: 1.8rem;
  }
  .volver-inicio {
    font-family: var(--fuente-codigo);
    font-size: 0.8rem;
  }

  /* Celular: menú horizontal desplazable */
  @media (max-width: 900px) {
    .lateral-titulo,
    .lista-lecciones,
    .volver-inicio,
    .cuenta {
      display: none;
    }
    .lista-modulos {
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding: 0.25rem 0.1rem 0.5rem;
      scrollbar-width: thin;
    }
    .lista-modulos > li {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
    .enlace-modulo {
      grid-template-columns: auto auto;
      border: 1px solid var(--borde);
      border-left: 1px solid var(--borde);
      border-bottom: 3px solid var(--mod);
      padding: 0.4rem 0.75rem;
      white-space: nowrap;
      font-size: 0.92rem;
    }
    .actual > .enlace-modulo {
      border-color: var(--mod);
    }
  }
</style>
