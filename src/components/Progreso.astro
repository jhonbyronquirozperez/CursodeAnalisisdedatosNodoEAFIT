---
// Barra de progreso: cuántas lecciones están en estado "lista".
interface Props {
  listas: number;
  total: number;
}
const { listas, total } = Astro.props;
const pct = total === 0 ? 0 : Math.round((listas / total) * 100);
---

<div
  class="progreso"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax={total}
  aria-valuenow={listas}
  aria-label={`${listas} de ${total} lecciones listas`}
>
  <span style={`width:${pct}%`}></span>
</div>

<style>
  .progreso {
    width: 100%;
    min-width: 4rem;
    height: 0.4rem;
    border-radius: 1px;
    background: var(--fondo-suave);
    box-shadow: inset 0 0 0 1px var(--borde);
    overflow: hidden;
  }
  span {
    display: block;
    height: 100%;
    background: var(--mod, var(--lima));
    border-radius: inherit;
    box-shadow: 0 0 10px var(--mod, var(--lima));
  }
</style>
