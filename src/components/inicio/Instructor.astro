---
import { Image } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import { curso } from '../../config/curso';
import foto from '../../assets/instructor.webp';

const { nombre, rol, bio, sitio, github, linkedin } = curso.instructor;
const redes = [
  { texto: 'Sitio personal', url: sitio },
  { texto: 'GitHub', url: github },
  { texto: 'LinkedIn', url: linkedin },
].filter((r) => r.url);
---

<section id="instructor" class="instructor contenedor" aria-labelledby="titulo-instructor">
  <div class="marco-foto">
    <span class="esquina e1" aria-hidden="true"></span>
    <span class="esquina e2" aria-hidden="true"></span>
    <Image
      src={foto}
      alt={`Foto de ${nombre}`}
      widths={[320, 520]}
      sizes="(max-width: 760px) 320px, 520px"
      loading="lazy"
    />
    <span class="etiqueta-foto" aria-hidden="true">ID://instructor</span>
  </div>

  <div class="datos">
    <p class="sobretitulo">Instructor</p>
    <h2 id="titulo-instructor">{nombre}</h2>
    {rol && <p class="rol">{rol}</p>}
    {bio ? <p class="bio">{bio}</p> : <Placeholder texto="Presentación del instructor por agregar (en src/config/curso.ts)" />}
    {
      redes.length > 0 && (
        <ul class="redes">
          {redes.map((r) => (
            <li>
              <a class="btn btn-secundario" href={r.url} target="_blank" rel="noopener noreferrer">
                {r.texto} <span aria-hidden="true">↗</span>
                <span class="sr-only">(se abre en otra pestaña)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .instructor {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 4rem;
    padding: 5rem 0;
  }
  .marco-foto {
    position: relative;
    max-width: 26rem;
    padding: 0.75rem;
    border: 1px solid var(--borde-fuerte);
    background: linear-gradient(160deg, rgb(255 90 31 / 0.18), transparent 45%, rgb(38 250 242 / 0.14));
  }
  .marco-foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 1045;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.9);
  }
  /* Líneas de escaneo muy suaves sobre la foto */
  .marco-foto::after {
    content: '';
    position: absolute;
    inset: 0.75rem;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, transparent 0 3px, rgb(0 0 0 / 0.12) 3px 4px);
  }
  .esquina {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid var(--naranja);
  }
  .e1 {
    top: -2px;
    left: -2px;
    border-right: 0;
    border-bottom: 0;
  }
  .e2 {
    bottom: -2px;
    right: -2px;
    border-left: 0;
    border-top: 0;
    border-color: var(--cian);
  }
  .etiqueta-foto {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 1;
    padding: 0.2rem 0.5rem;
    font-family: var(--fuente-codigo);
    font-size: 0.7rem;
    color: var(--fondo);
    background: var(--lima);
  }

  h2 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
  }
  .rol {
    margin: 0 0 1.5rem;
    font-family: var(--fuente-codigo);
    font-size: 0.9rem;
    color: var(--naranja);
  }
  .bio {
    margin: 0;
    font-size: 1.15rem;
    color: var(--texto-suave);
    max-width: 38rem;
  }
  .redes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  @media (max-width: 760px) {
    .instructor {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding: 3.5rem 0;
    }
    .marco-foto {
      max-width: 18rem;
    }
  }
</style>
