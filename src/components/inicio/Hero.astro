---
// Portada: título, llamado a la acción y panel de datos animado (solo CSS + SVG).
import { curso } from '../../config/curso';
import { obtenerCurso, urlModulo, dosDigitos } from '../../lib/curso';
import { colorModulo } from '../../lib/colores';

const modulos = await obtenerCurso();
const totalLecciones = modulos.reduce((s, m) => s + m.lecciones.length, 0);
const totalListas = modulos.reduce((s, m) => s + m.listas, 0);
const primero = modulos[0];

// Dona: un segmento por módulo, con el color de cada uno
const radio = 40;
const circunferencia = 2 * Math.PI * radio;
const segmento = circunferencia / Math.max(modulos.length, 1);
const separacion = 3;

// Gráfico decorativo del panel
const barras = [42, 64, 50, 78, 58, 88, 72, 96];
const tendencia = barras.map((h, i) => `${19 + i * 28},${104 - h}`).join(' ');
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero-fondo" aria-hidden="true">
    <div class="resplandor"></div>
    <div class="piso"><div class="rejilla"></div></div>
    <div class="scan"></div>
  </div>

  <div class="hero-interno contenedor">
    <div class="hero-texto">
      <p class="consola" aria-hidden="true">
        <span class="prompt">&gt;</span>
        <span class="escribe">cargando curso.analisis_datos</span><span class="cursor"></span>
      </p>

      <h1 id="hero-titulo" class="titulo">
        <span class="glitch">
          {curso.titulo}
          <span class="capa c1" aria-hidden="true">{curso.titulo}</span>
          <span class="capa c2" aria-hidden="true">{curso.titulo}</span>
        </span>
      </h1>

      <p class="lema">{curso.descripcion || curso.lema}</p>

      <div class="acciones">
        {
          primero && (
            <a class="btn btn-primario" href={urlModulo(primero)}>
              Empezar el curso <span aria-hidden="true">→</span>
            </a>
          )
        }
        <a class="btn btn-secundario" href="#modulos">Ver módulos</a>
      </div>

      <dl class="stats">
        <div>
          <dt>Módulos</dt>
          <dd>{dosDigitos(modulos.length)}</dd>
        </div>
        <div>
          <dt>Lecciones</dt>
          <dd>{dosDigitos(totalLecciones)}</dd>
        </div>
        <div>
          <dt>Listas</dt>
          <dd>{dosDigitos(totalListas)}</dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="panel">
        <span class="esquina e1"></span><span class="esquina e2"></span>
        <span class="esquina e3"></span><span class="esquina e4"></span>

        <div class="panel-barra">
          <span>/dev/datos</span>
          <span class="vivo">● LIVE</span>
        </div>

        <svg class="grafico" viewBox="0 0 240 112">
          <defs>
            <linearGradient id="grad-barra" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#26faf2"></stop>
              <stop offset="1" stop-color="#26faf2" stop-opacity="0.08"></stop>
            </linearGradient>
          </defs>
          {[24, 52, 80].map((y) => <line class="guia" x1="0" x2="240" y1={y} y2={y} />)}
          {
            barras.map((h, i) => (
              <rect class="barra" x={10 + i * 28} y={104 - h} width="18" height={h} style={`--i:${i}`} />
            ))
          }
          <polyline class="tendencia" points={tendencia}></polyline>
          <line class="base" x1="0" x2="240" y1="104" y2="104"></line>
        </svg>

        <div class="panel-fila">
          <svg class="dona" viewBox="0 0 100 100">
            <g>
              {
                modulos.map((m, i) => (
                  <circle
                    cx="50"
                    cy="50"
                    r={radio}
                    stroke={colorModulo(m.id)}
                    stroke-dasharray={`${segmento - separacion} ${circunferencia - segmento + separacion}`}
                    stroke-dashoffset={-i * segmento}
                  />
                ))
              }
            </g>
            <text x="50" y="50" class="dona-num">{modulos.length}</text>
            <text x="50" y="64" class="dona-txt">MÓDULOS</text>
          </svg>
          <ul class="leyenda">
            {
              modulos.map((m) => (
                <li style={`--c:${colorModulo(m.id)}`}>
                  <span>{dosDigitos(m.data.orden)}</span> {m.data.titulo}
                </li>
              ))
            }
          </ul>
        </div>

        <p class="panel-consulta">
          <span class="prompt">&gt;</span> SELECT insight FROM datos;<span class="cursor"></span>
        </p>
      </div>

      <span class="chip ch1">JOIN</span>
      <span class="chip ch2">df.describe()</span>
      <span class="chip ch3">GROUP BY</span>
      <span class="chip ch4">∑ DAX</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(88vh, 54rem);
    display: flex;
    align-items: center;
    padding: 5rem 0 6rem;
    border-bottom: 1px solid var(--borde);
  }

  /* ----- Fondo ----- */
  .hero-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .resplandor {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 78% 30%, rgb(255 90 31 / 0.16), transparent 70%),
      radial-gradient(45% 45% at 10% 20%, rgb(38 250 242 / 0.1), transparent 70%),
      radial-gradient(70% 40% at 50% 100%, rgb(255 79 154 / 0.14), transparent 70%);
  }
  .piso {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: 0;
    height: 48%;
    perspective: 320px;
    overflow: hidden;
    mask-image: linear-gradient(to top, black 10%, transparent 90%);
  }
  .rejilla {
    position: absolute;
    inset: -100% 0 0;
    transform-origin: 50% 100%;
    transform: rotateX(62deg);
    background-image:
      linear-gradient(rgb(255 79 154 / 0.45) 1px, transparent 1px),
      linear-gradient(90deg, rgb(38 250 242 / 0.35) 1px, transparent 1px);
    background-size: 56px 56px;
    animation: avanzar 2.8s linear infinite;
    will-change: transform;
  }
  @keyframes avanzar {
    to {
      transform: rotateX(62deg) translateY(56px);
    }
  }
  .scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0 3px, rgb(0 0 0 / 0.22) 3px 4px);
  }

  /* ----- Texto ----- */
  .hero-interno {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 4rem;
  }
  .consola {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    font-family: var(--fuente-codigo);
    font-size: 0.85rem;
    color: var(--lima);
  }
  .prompt {
    color: var(--naranja);
  }
  .escribe {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 29ch;
    animation: escribir 1.6s steps(29) 0.3s both;
  }
  @keyframes escribir {
    from {
      width: 0;
    }
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: currentColor;
    animation: parpadeo 1s steps(1) infinite;
  }
  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .titulo {
    margin: 0;
    font-size: clamp(2.9rem, 7.4vw, 6.2rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .glitch {
    position: relative;
    display: inline-block;
    text-shadow:
      0 0 28px rgb(255 90 31 / 0.35),
      0 0 2px rgb(255 255 255 / 0.4);
  }
  /* Línea de neón bajo el título */
  .glitch::after {
    content: '';
    display: block;
    height: 4px;
    width: 7.5rem;
    margin-top: 1.4rem;
    background: linear-gradient(90deg, var(--naranja), var(--rosa), var(--cian));
    box-shadow: 0 0 18px rgb(255 79 154 / 0.6);
  }
  .capa {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .c1 {
    color: var(--cian);
    animation: glitch-a 0.75s steps(1) 0.9s both;
  }
  .c2 {
    color: var(--rosa);
    animation: glitch-b 0.75s steps(1) 0.9s both;
  }
  .titulo:hover .c1 {
    animation: glitch-a2 0.75s steps(1) both;
  }
  .titulo:hover .c2 {
    animation: glitch-b2 0.75s steps(1) both;
  }
  @keyframes glitch-a {
    0% { opacity: 0.85; transform: translate(-4px, 1px); clip-path: inset(8% 0 62% 0); }
    25% { transform: translate(4px, -1px); clip-path: inset(52% 0 22% 0); }
    50% { transform: translate(-2px, 0); clip-path: inset(78% 0 4% 0); }
    75% { transform: translate(3px, 1px); clip-path: inset(30% 0 48% 0); }
    100% { opacity: 0; }
  }
  @keyframes glitch-b {
    0% { opacity: 0.85; transform: translate(4px, -1px); clip-path: inset(60% 0 12% 0); }
    25% { transform: translate(-3px, 1px); clip-path: inset(14% 0 66% 0); }
    50% { transform: translate(3px, 0); clip-path: inset(40% 0 38% 0); }
    75% { transform: translate(-4px, -1px); clip-path: inset(84% 0 2% 0); }
    100% { opacity: 0; }
  }
  @keyframes glitch-a2 {
    0% { opacity: 0.85; transform: translate(-4px, 1px); clip-path: inset(8% 0 62% 0); }
    25% { transform: translate(4px, -1px); clip-path: inset(52% 0 22% 0); }
    50% { transform: translate(-2px, 0); clip-path: inset(78% 0 4% 0); }
    75% { transform: translate(3px, 1px); clip-path: inset(30% 0 48% 0); }
    100% { opacity: 0; }
  }
  @keyframes glitch-b2 {
    0% { opacity: 0.85; transform: translate(4px, -1px); clip-path: inset(60% 0 12% 0); }
    25% { transform: translate(-3px, 1px); clip-path: inset(14% 0 66% 0); }
    50% { transform: translate(3px, 0); clip-path: inset(40% 0 38% 0); }
    75% { transform: translate(-4px, -1px); clip-path: inset(84% 0 2% 0); }
    100% { opacity: 0; }
  }

  .lema {
    max-width: 34rem;
    margin: 1.5rem 0 2rem;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.55;
    color: var(--texto-suave);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 2.75rem 0 0;
    border-top: 1px solid var(--borde-fuerte);
    max-width: 30rem;
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    flex: 1;
    padding: 0.9rem 1rem 0 0;
  }
  .stats > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--borde);
  }
  .stats dt {
    font-family: var(--fuente-codigo);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }
  .stats dd {
    margin: 0;
    font-family: var(--fuente-codigo);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--texto);
  }
  .stats > div:nth-child(1) dd { color: var(--cian); }
  .stats > div:nth-child(2) dd { color: var(--lima); }
  .stats > div:nth-child(3) dd { color: var(--naranja); }

  /* ----- Panel de datos ----- */
  .hero-visual {
    position: relative;
    animation: flotar 7s ease-in-out infinite;
  }
  @keyframes flotar {
    50% {
      transform: translateY(-10px);
    }
  }
  .panel {
    position: relative;
    padding: 1rem 1.15rem 1.1rem;
    background: rgb(14 18 16 / 0.78);
    border: 1px solid rgb(38 250 242 / 0.22);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 30px 80px -20px rgb(255 79 154 / 0.28),
      inset 0 0 40px rgb(38 250 242 / 0.04);
    backdrop-filter: blur(6px);
    font-family: var(--fuente-codigo);
  }
  .esquina {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--cian);
  }
  .e1 { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
  .e2 { top: -2px; right: -2px; border-left: 0; border-bottom: 0; }
  .e3 { bottom: -2px; left: -2px; border-right: 0; border-top: 0; }
  .e4 { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }

  .panel-barra {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--texto-suave);
    padding-bottom: 0.6rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px dashed var(--borde-fuerte);
  }
  .vivo {
    color: var(--rosa);
    animation: parpadeo 2s steps(1) infinite;
  }

  .grafico {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .guia {
    stroke: rgb(255 255 255 / 0.06);
    stroke-dasharray: 2 4;
  }
  .base {
    stroke: var(--borde-fuerte);
  }
  .barra {
    fill: url(#grad-barra);
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: pulso 2.6s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.4s);
  }
  @keyframes pulso {
    from {
      transform: scaleY(0.6);
    }
  }
  .tendencia {
    fill: none;
    stroke: var(--lima);
    stroke-width: 2;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 4px rgb(203 255 61 / 0.7));
    stroke-dasharray: 260;
    animation: trazar 2.2s ease-out 0.6s both;
  }
  @keyframes trazar {
    from {
      stroke-dashoffset: 260;
    }
  }

  .panel-fila {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .dona circle {
    fill: none;
    stroke-width: 9;
  }
  .dona g {
    transform-box: view-box;
    transform-origin: 50px 50px;
    transform: rotate(-90deg);
    animation: girar 40s linear infinite;
  }
  @keyframes girar {
    to {
      transform: rotate(270deg);
    }
  }
  .dona-num {
    fill: var(--texto);
    font-size: 22px;
    font-weight: 600;
    text-anchor: middle;
  }
  .dona-txt {
    fill: var(--texto-suave);
    font-size: 7px;
    letter-spacing: 0.1em;
    text-anchor: middle;
  }
  .leyenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    font-size: 0.68rem;
    color: var(--texto-suave);
  }
  .leyenda li {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .leyenda span {
    color: var(--c);
  }

  .panel-consulta {
    margin: 1rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--borde-fuerte);
    font-size: 0.75rem;
    color: var(--cian);
  }

  .chip {
    position: absolute;
    padding: 0.25rem 0.55rem;
    font-family: var(--fuente-codigo);
    font-size: 0.7rem;
    background: var(--fondo);
    border: 1px solid currentColor;
    animation: flotar 5s ease-in-out infinite;
  }
  .ch1 { top: -1.2rem; left: 12%; color: var(--lima); animation-delay: -1s; }
  .ch2 { top: 38%; right: -2.2rem; color: var(--rosa); animation-delay: -2.5s; }
  .ch3 { bottom: -1.1rem; left: -1.5rem; color: var(--naranja); animation-delay: -3.5s; }
  .ch4 { bottom: 22%; left: -2.6rem; color: var(--cian); animation-delay: -0.5s; }

  /* ----- Responsive ----- */
  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding: 3.5rem 0 4.5rem;
    }
    .hero-interno {
      grid-template-columns: minmax(0, 1fr);
      gap: 3.5rem;
    }
    .hero-visual {
      max-width: 28rem;
      width: 100%;
      margin-inline: auto;
    }
    .ch2 { right: -0.5rem; }
    .ch4 { left: -0.5rem; }
    .ch3 { left: 0.5rem; }
  }
  @media (max-width: 480px) {
    .consola {
      font-size: 0.75rem;
    }
    .stats dd {
      font-size: 1.5rem;
    }
    .chip {
      display: none;
    }
  }
</style>
